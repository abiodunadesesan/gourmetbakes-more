# Copy to .env.local and fill in values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp (optional — customer confirmations + ADMIN_PHONE shop alerts)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_BUSINESS_PHONE=whatsapp:+1...
# ADMIN_PHONE=+234...  (you — receives new orders + form alerts via WhatsApp)

# Email notifications (Resend — https://resend.com)
# 1. Create API key in Resend dashboard
# 2. INBOUND_FORM_EMAIL = your personal inbox (where form submissions go)
# 3. For production, verify a domain and set RESEND_FROM_EMAIL, e.g.:
#    RESEND_FROM_EMAIL="Gourmet Bakes <hello@yourdomain.com>"
#    Until then you can use Resend test sender (limits apply):
# RESEND_API_KEY=re_xxxxxxxx
# INBOUND_FORM_EMAIL=you@example.com
# RESEND_FROM_EMAIL=Gourmet Bakes <onboarding@resend.dev>

# Noupe AI chatbot (https://www.noupe.com)
# Train on production: https://gourmetbakes.vercel.app → then Get Your Code
# Add the same NEXT_PUBLIC_* vars in Vercel (Production) so the widget loads on the live site.
# NEXT_PUBLIC_NOUPE_SCRIPT_URL=https://...
# NEXT_PUBLIC_NOUPE_WIDGET_ID=
#
# Noupe → Resend via POST /api/integrations/noupe-chat (README: Noupe + Resend)
# Preferred: Zapier/Make — server-only secret (never commit a real value). Use Bearer or x-noupe-webhook-secret.
# NOUPE_CHAT_WEBHOOK_SECRET=
# Fallback: browser postMessage bridge — same random string in Vercel (exposed in JS; rotate if abused)
# NEXT_PUBLIC_NOUPE_BROWSER_INGEST_KEY=
# Optional: verbose `[Noupe bridge]` console logs on production (set to 1, redeploy, then remove)
# NEXT_PUBLIC_NOUPE_BRIDGE_DEBUG=
# (optional server alias) NOUPE_BROWSER_INGEST_KEY=  # same value as NEXT_PUBLIC if you prefer not to use NEXT_PUBLIC name on the server
